 "captions": [
  {
   "scene": "dream",
   "from": 12,
   "to": 140,
   "style": "sub",
   "text": "Every business begins with a dream.",
   "start": 12,
   "end": 140
  },
  {
   "scene": "dream",
   "from": 150,
   "to": 304,
   "style": "sub",
   "text": "To reach more people. To grow beyond familiar streets.",
   "start": 150,
   "end": 304
  },
  {
   "scene": "barrier",
   "from": 120,
   "to": 186,
   "style": "sub",
   "text": "Websites. Branding. Marketing. Different providers.",
   "start": 440,
   "end": 506
  },
  {
   "scene": "barrier",
   "from": 190,
   "to": 256,
   "style": "sub",
   "text": "Costs that can make even big dreams feel out of reach.",
   "start": 510,
   "end": 576
  },
  {
   "scene": "barrier",
   "from": 282,
   "to": 392,
   "style": "thought",
   "text": "“Maybe businesses like mine will never go digital.”",
   "start": 602,
   "end": 712
  },
  {
   "scene": "realize",
   "from": 24,
   "to": 150,
   "style": "sub",
   "text": "Across different workspaces, experienced engineers saw the same problem.",
   "start": 744,
   "end": 870
  },
  {
   "scene": "realize",
   "from": 160,
   "to": 272,
   "style": "quote",
   "text": "“Small businesses don't lack potential. They lack access to the right expertise.”",
   "start": 880,
   "end": 992
  },
  {
   "scene": "realize",
   "from": 284,
   "to": 394,
   "style": "quote",
   "text": "“What if we brought the expertise directly to them?”",
   "start": 1004,
   "end": 1114
  },
  {
   "scene": "birth",
   "from": 12,
   "to": 118,
   "style": "title",
   "text": "Different skills. One shared mission.",
   "start": 1132,
   "end": 1238
  },
  {
   "scene": "birth",
   "from": 150,
   "to": 232,
   "style": "title",
   "text": "Introducing HiBrands.",
   "start": 1270,
   "end": 1352
  },
  {
   "scene": "birth",
   "from": 236,
   "to": 316,
   "style": "title",
   "text": "Engineers, not an agency.",
   "start": 1356,
   "end": 1436
  },
  {
   "scene": "work",
   "from": 14,
   "to": 128,
   "style": "sub",
   "text": "Direct access to skilled engineers. No middlemen.",
   "start": 1454,
   "end": 1568
  },
  {
   "scene": "work",
   "from": 140,
   "to": 270,
   "style": "sub",
   "text": "Websites. Landing pages. SEO. Social media. Google Ads.",
   "start": 1580,
   "end": 1710
  },
  {
   "scene": "work",
   "from": 280,
   "to": 396,
   "style": "sub",
   "text": "You don't need an entire agency. You need the right people, working together.",
   "start": 1720,
   "end": 1836
  },
  {
   "scene": "compare",
   "from": 8,
   "to": 110,
   "style": "title",
   "text": "Traditional agency overhead",
   "start": 1848,
   "end": 1950
  },
  {
   "scene": "compare",
   "from": 100,
   "to": 236,
   "style": "title",
   "text": "Direct access to the people building your product",
   "start": 1940,
   "end": 2076
  },
  {
   "scene": "transform",
   "from": 24,
   "to": 150,
   "style": "sub",
   "text": "What once felt impossible began to feel possible.",
   "start": 2104,
   "end": 2230
  },
  {
   "scene": "transform",
   "from": 170,
   "to": 270,
   "style": "sub",
   "text": "Not because he stopped dreaming.",
   "start": 2250,
   "end": 2350
  },
  {
   "scene": "transform",
   "from": 282,
   "to": 396,
   "style": "sub",
   "text": "But because he finally found people ready to help him build it.",
   "start": 2362,
   "end": 2476
  },
  {
   "scene": "ending",
   "from": 30,
   "to": 236,
   "style": "title",
   "text": "Your business has potential. Let's build what's next.",
   "start": 2510,
   "end": 2716
  }
 ],
